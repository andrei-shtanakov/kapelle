{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:impresario:contract:exchange-log:v1",
  "title": "ExchangeLog",
  "description": "Журнал итераций цикла researcher ↔ creator (docs/semantics.md, ExchangeLog). Без журнала цикл нетрассируем. Монотонность итераций — tool-enforced.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "proposal_ref", "entries"],
  "properties": {
    "id": { "type": "string", "pattern": "^XL-[0-9]{3,}$" },
    "proposal_ref": { "type": "string", "pattern": "^proposal://PP-[0-9]{3,}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iteration", "actor", "artifact_kind", "artifact_ref", "at"],
      "properties": {
        "iteration": { "type": "integer", "minimum": 0 },
        "actor": { "enum": ["researcher", "creator", "orchestration", "human"] },
        "artifact_kind": {
          "enum": ["research_pack", "concept_draft", "product_proposal_patch", "note"]
        },
        "artifact_ref": { "type": "string", "minLength": 1 },
        "at": { "$ref": "#/$defs/timestamp" },
        "requests_opened": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "requests_closed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "note": { "type": "string" }
      }
    }
  }
}
