{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:impresario:contract:idea:v1",
  "title": "Idea",
  "description": "Карточка идеи (docs/semantics.md, Idea). business_attractiveness — pre-triage поле, в scoring policy стадии 4 не входит.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "date",
    "source",
    "priority",
    "business_attractiveness",
    "status",
    "hypothesis"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^IDEA-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": ["market", "customer", "hd", "competitor", "strategy", "rd", "internal", "other"]
        },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "priority": { "enum": ["high", "medium", "low"] },
    "business_attractiveness": { "type": "integer", "minimum": 1, "maximum": 5 },
    "status": {
      "enum": ["new", "under_review", "selected", "parked", "rejected", "merged"]
    },
    "owner": { "type": "string" },
    "type": { "enum": ["new_product", "enhancement", "test_product"] },
    "hypothesis": { "type": "string", "minLength": 1 },
    "essence": { "type": "string" },
    "problem": { "type": "string" },
    "solution": { "type": "string" },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  }
}
